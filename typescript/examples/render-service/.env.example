# Copy to .env and fill in. Every value below is required; the service refuses to start without one.
# Do not commit the filled-in copy — the repo's .gitignore excludes .env for this reason.

# Postgres connection string for the credential store.
DATABASE_URL=

# 32 bytes for the AES-256-GCM credential envelope, as base64, base64url, or 64 hex characters.
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CHATGPT_OAUTH_KEY=

# At least 32 bytes. Signs the demo session cookie; unrelated to CHATGPT_OAUTH_KEY, so use a
# separate value. Generate one the same way as above.
SESSION_SECRET=

# Absolute public origin of this service, used to build the OAuth redirect URI. Must be the exact
# origin the browser reaches, including scheme and any non-default port.
PUBLIC_URL=http://localhost:3000

# Optional. Defaults to 3000; PUBLIC_URL above wins when both are set.
PORT=3000
